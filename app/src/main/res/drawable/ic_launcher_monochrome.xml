<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher_monochrome.xml
  单色层：Android 13+ (API 33+) 主题图标用，系统自动染色（暗色模式下变灰白）
  path 沿用前景层，颜色统一为不透明色（系统会替换为单色）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 钱币外圈 -->
    <path
        android:pathData="M54,54 m-26,0 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0"
        android:strokeColor="#FF000000"
        android:strokeWidth="4.5"
        android:fillColor="#00000000" />

    <!-- 钱币内圈 -->
    <path
        android:pathData="M54,54 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <!-- 趋势折线 -->
    <path
        android:pathData="M40,62 L48,55 L55,58 L62,47 L70,52"
        android:strokeColor="#FF000000"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 端点 -->
    <path
        android:pathData="M70,52 m-2.8,0 a2.8,2.8 0 1,0 5.6,0 a2.8,2.8 0 1,0 -5.6,0"
        android:fillColor="#FF000000" />
</vector>
